WEBGAZE_ENVIRONMENT=development
WEBGAZE_DATABASE_URL=postgresql+psycopg://webgaze:webgaze@localhost:5432/webgaze
WEBGAZE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
WEBGAZE_SQL_ECHO=false
WEBGAZE_RESEARCHER_AUTH_REQUIRED=false
WEBGAZE_RESEARCHER_SESSION_HOURS=12
WEBGAZE_RATE_LIMIT_ENABLED=true
# Auto selects database in production and memory in local development.
WEBGAZE_RATE_LIMIT_BACKEND=auto
WEBGAZE_LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBGAZE_PARTICIPANT_RATE_LIMIT_PER_MINUTE=120
WEBGAZE_TRUST_PROXY_HEADERS=false
WEBGAZE_DEMO_RESEARCHER_EMAIL=demo@webgaze.local
# Set only when seeding a researcher account; use a unique secret of at least 12 characters.
WEBGAZE_DEMO_RESEARCHER_PASSWORD=
