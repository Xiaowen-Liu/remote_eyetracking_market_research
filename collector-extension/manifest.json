{
  "manifest_version": 3,
  "name": "WebGaze Research Collector (Experimental)",
  "version": "0.1.0",
  "description": "Clean-room browser collector for consented UX-research session events and optional visible-tab snapshots.",
  "permissions": ["activeTab", "storage", "tabs", "downloads"],
  "host_permissions": ["https://cdn.jsdelivr.net/*", "https://storage.googleapis.com/*", "https://remoteeyetrackingmarketresearch-production.up.railway.app/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "WebGaze Collector" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["dist/content.js", "content.js"], "css": ["src/overlay.css"], "run_at": "document_idle" }]
}
